services:
  - type: web
    name: watsonmemorial-web
    env: python
    plan: starter
    buildCommand: |
      pip install -r requirements.txt
      python manage.py collectstatic --noinput
      python manage.py migrate
    startCommand: gunicorn Events.wsgi:application --timeout 120
    envVars:
      - key: DJANGO_SETTINGS_MODULE
        value: watsonmemorial.settings
      - key: DATABASE_URL
        sync: false
      - key: SECRET_KEY
        sync: false
    disk:
      name: media-disk
      mountPath: /var/media
      sizeGB: 5

  - type: worker
    name: watsonmemorial-camera-worker
    env: python
    plan: starter
    buildCommand: pip install -r requirements.txt
    startCommand: python manage.py run_camera_worker
    envVars:
      - key: DJANGO_SETTINGS_MODULE
        value: watsonmemorial.settings
      - key: DATABASE_URL
        sync: false
      - key: SECRET_KEY
        sync: false
    disk:
      name: media-disk
      mountPath: /var/media
      sizeGB: 5
