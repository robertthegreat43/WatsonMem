services:
  - type: web
    name: watsonmemorial-web
    env: python
    buildCommand: |
      pip install -r requirements.txt
      python manage.py collectstatic --noinput
      python manage.py migrate
    startCommand: gunicorn WatsonMemorial.wsgi:application
    envVars:
      - key: DJANGO_SETTINGS_MODULE
        value: WatsonMemorial.settings
      - key: DATABASE_URL
        sync: false
      - key: SECRET_KEY
        sync: false
